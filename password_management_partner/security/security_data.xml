<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="password_user" model="res.groups">
            <field name="name">Password Management (for partners) - user</field>
        </record>

        <record id="password_manager" model="res.groups">
            <field name="name">Password Management (for partners) - manager</field>
            <field name="implied_ids" eval="[(4, ref('password_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>

        <record id="password_manager_do_everything" model="ir.rule">
            <field name="name">Password Management (for partners) - manager can do everything</field>
            <field name="model_id" ref="model_res_partner_password"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('password_manager'))]"/>
        </record>

        <!--
        <record id="password_management_partner_user_rule_1" model="ir.rule">
            <field name="name">Password Management (for partners) - users can edit their own records</field>
            <field name="model_id" ref="model_res_partner_password"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('create_uid', '=', [user.id])]</field>
            <field name="groups" eval="[(4, ref('password_management_partner_user'))]"/>
        </record>
        -->

        <record id="password_user_own_associated" model="ir.rule">
            <field name="name">Password Management (for partners) - users 'own' the records associated to them</field>
            <field name="model_id" ref="model_res_partner_password"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('password_user'))]"/>
        </record>

    </data>
</odoo>
